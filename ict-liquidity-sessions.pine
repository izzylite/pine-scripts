po3_open_show       = input.bool(true, "Open Line", inline = "PO3O", group = g_PO3)
po3_open_col        = input.color(color.black, "", inline = "PO3O", group = g_PO3)
po3_open_w          = input.int(1, "Width", 1, 4, inline = "PO3O", group = g_PO3, tooltip = "Dotted line from where the current candle opened")
po3_hl_show         = input.bool(true, "H / L Lines", inline = "PO3HL", group = g_PO3)
po3_hl_col          = input.color(color.black, "", inline = "PO3HL", group = g_PO3)
po3_hl_w            = input.int(1, "Width", 1, 4, inline = "PO3HL", group = g_PO3, tooltip = "Dotted lines from where the current candle's high and low formed")
po3_tbl_show        = input.bool(true, "Info Table", inline = "PO3T", group = g_PO3)
po3_range_unit      = input.string('Price', "Range in", options = ['Price', 'Ticks'], inline = "PO3T", group = g_PO3, tooltip = "Time left on the current candle, and its high - low range")
po3_tbl_v           = input.string('Middle', "Table Position", options = ['Top', 'Middle', 'Bottom'], inline = "PO3T2", group = g_PO3)
po3_tbl_h           = input.string('Right', "", options = ['Left', 'Center', 'Right'], inline = "PO3T2", group = g_PO3)
po3_tbl_bg          = input.color(#d1d4dc, "Background", inline = "PO3T3", group = g_PO3)
po3_tbl_txt         = input.color(color.black, "Text", inline = "PO3T3", group = g_PO3)

// ---------------------------------------- iZZY MOD END--------------------------------------------------
// ---------------------------------------- Inputs --------------------------------------------------


// ---------------------------------------- Variables & Constants --------------------------------------------------
type quater_cycles
    string q1
    string q2
    string q3
    string q4_s
    string q4_e
    line[] _line
    int[]  _ts          // Q1-Q4 start times of the current cycle, cached when the cycle begins

type kz
    string  _title
    bool    is_session  // session boxes draw no pivot lines; their high/low is only tracked for alerts
    box[]   _box
    float[] _hi         // running high/low of each session, newest first (replaces reading them back from drawings)
    float[] _lo
    bool[]  _hi_valid   // false once the level is broken or cut off
    bool[]  _lo_valid
    line[]  _hi_line
    line[]  _lo_line
    line[]  _md_line

type hz
    line[]  LN
    label[] LB
    bool[]  DONE        // true once the line has stopped extending (cutoff hit, or the next open started)

// Previous-period highs (or lows) for one timeframe, newest first
type prev_lvl
    string  tf          // "D", "W", "M" or "Y" -> names PD / P2D ..., PW / P2W ..., PM / P2M ..., PY / P2Y ...
    bool    is_high
    color   col
    int     max_n
    int     hide_ms     // broken levels are removed this long after they broke
    int     period      // number of periods started so far
    float   nearest     // closest unbroken level to price (lowest high / highest low), na if none
    line[]  ln
    label[] lb
    float[] lvl
    bool[]  hit
    int[]   hit_time
    int[]   per_no      // 'period' when created; turns into the "PD" / "P2D" names. per_no == period -> current period's level

// Running high/low of the current period and the completed previous one
type hl_track
    float h
    float l
    bool  full          // false while the current period started before the chart's first bar
    float ph
    float pl

// D / W / M / Y opening price lines, newest first
type open_lvl
    string  tf          // "D", "W", "M" or "Y"
    color   col
    float   o           // the current period's open
    int     alert_t     // bar time of the last "price hit" alert
    line[]  ln
    label[] lb

new_open_lvl(string tf, color col) =>
    open_lvl.new(tf, col, na, 0, array.new_line(), array.new_label())

new_prev_lvl(string tf, bool is_high, color col, int max_n, int hide_ms) =>
    prev_lvl.new(tf, is_high, col, max_n, hide_ms, 0, na, array.new_line(), array.new_label(), array.new_float(), array.new_bool(), array.new_int(), array.new_int())

new_kz(string title, bool is_session) =>
    kz.new(title, is_session, array.new_box(), array.new_float(), array.new_float(), array.new_bool(), array.new_bool(), array.new_line(), array.new_line(), array.new_line())

new_hz() =>
    hz.new(array.new_line(), array.new_label(), array.new_bool())

var as_kz = new_kz(as_txt_kz, false)
var lo_kz = new_kz(lo_txt_kz, false)
var na_kz = new_kz(nyam_txt_kz, false)
var np_kz = new_kz(nypm_txt_kz, false)

var as_ss = new_kz(as_txt_ss, true)
var lo_ss = new_kz(lo_txt_ss, true)
var na_ss = new_kz(ny_txt_ss, true)
var nl_ss = new_kz(nl_txt_ss, true)
var np_ss = new_kz(np_txt_ss, true)

var london_cycle = quater_cycles.new("0000","0130","0300","0430","0600", array.new_line(), array.new_int())
var ny_cycle     = quater_cycles.new("0600","0730","0900","1030","1200", array.new_line(), array.new_int())

var hz_1 = new_hz()
var hz_2 = new_hz()
var hz_3 = new_hz()
var hz_4 = new_hz()

var v1_line = array.new_line()
var v2_line = array.new_line()
var v3_line = array.new_line()

var pd_high_lv = new_prev_lvl("D", true,  pdl_color, pdl_max, pdl_hide_days * 86400000)
var pd_low_lv  = new_prev_lvl("D", false, pdl_color, pdl_max, pdl_hide_days * 86400000)
var pw_high_lv = new_prev_lvl("W", true,  pwl_color, pwl_max, pdl_hide_days * 5 * 86400000)
var pw_low_lv  = new_prev_lvl("W", false, pwl_color, pwl_max, pdl_hide_days * 5 * 86400000)
var pm_high_lv = new_prev_lvl("M", true,  pml_color, pml_max, pdl_hide_days * 20 * 86400000)
var pm_low_lv  = new_prev_lvl("M", false, pml_color, pml_max, pdl_hide_days * 20 * 86400000)
var py_high_lv = new_prev_lvl("Y", true,  pyl_color, pyl_max, pdl_hide_days * 240 * 86400000)
var py_low_lv  = new_prev_lvl("Y", false, pyl_color, pyl_max, pdl_hide_days * 240 * 86400000)

var d_track = hl_track.new(na, na, false, na, na)
var w_track = hl_track.new(na, na, false, na, na)
var m_track = hl_track.new(na, na, false, na, na)
var y_track = hl_track.new(na, na, false, na, na)
var py_seeded = false

var d_open_lv = new_open_lvl("D", pdl_color)
var w_open_lv = new_open_lvl("W", pwl_color)
var m_open_lv = new_open_lvl("M", pml_color)
var y_open_lv = new_open_lvl("Y", pyl_color)
var y_open_seeded = false

var d_div = array.new_line()
var w_div = array.new_line()
var m_div = array.new_line()
var y_div = array.new_line()

var transparent = #ffffff00
var ext_current = ext_which == 'Most Recent'
var ext_past    = ext_pivots == 'Past Mitigation'
var show_md     = show_pivots and show_midpoints

// PERF: timeframe checks are evaluated once instead of inside every function on every bar
var tf_sec   = timeframe.in_seconds("")
var tf_ok    = tf_sec <= timeframe.in_seconds(tf_limit)
var qc_tf_ok = tf_sec <= timeframe.in_seconds("30")

// PERF: only the newest drawings are kept, so bars older than this would only create drawings that get deleted again.
// Sessions -> calendar days (x1.5 covers weekends), plus slack for holidays.
var lookback_ms = (math.ceil(math.max(max_days, vl_limit, qt_max) * 1.5) + 5) * 86400000
in_window = time >= last_bar_time - lookback_ms

t_as_kz = not na(time("", asia_kz, gmt_tz))
t_lo_kz = not na(time("", london_kz, gmt_tz))
t_na_kz = not na(time("", nyam_kz, gmt_tz))
t_np_kz = not na(time("", nypm_kz, gmt_tz))

t_as_ss = not na(time("", asia_session, gmt_tz))
t_lo_ss = not na(time("", london_session, gmt_tz))
t_na_ss = not na(time("", ny_session, gmt_tz))
t_nl_ss = not na(time("", nylu_session, gmt_tz))
t_np_ss = not na(time("", nypm_session, gmt_tz))

t_co    = not na(time("", cutoff, gmt_tz))
t_co_kz = not na(time("", cutoff_kz, gmt_tz))

t_h1 = not na(time("", h1, gmt_tz))
t_h2 = not na(time("", h2, gmt_tz))
t_h3 = not na(time("", h3, gmt_tz))
t_h4 = not na(time("", h4, gmt_tz))

t_v1 = not na(time("", v1, gmt_tz))
t_v2 = not na(time("", v2, gmt_tz))
t_v3 = not na(time("", v3, gmt_tz))

t_l_c  = not na(time("", "0000-0600", gmt_tz))
t_ny_c = not na(time("", "0600-1200", gmt_tz))

// Bar history is read here, at global scope, so the functions below can be called conditionally
prev_time = time[1]
prev_high = high[1]
prev_low  = low[1]
bar_step  = time[1] - time[2]

// PERF: previous day/week/month highs & lows are built from the chart's own bars (no request.security calls),
// and each only processes the bars that can still hold its kept levels
var pdl_tf_ok       = tf_sec <= timeframe.in_seconds(pdl_tf_limit)
var pwl_tf_ok       = tf_sec <= timeframe.in_seconds(pwl_tf_limit)
var pml_tf_ok       = tf_sec <= timeframe.in_seconds(pml_tf_limit)
var pyl_tf_ok       = tf_sec <= timeframe.in_seconds(pyl_tf_limit)
var pdl_lookback_ms = (math.ceil(pdl_max * 1.5) + 5) * 86400000
var pwl_lookback_ms = (pwl_max * 7 + 10) * 86400000
var pml_lookback_ms = (pml_max * 31 + 10) * 86400000
var pyl_lookback_ms = (pyl_max * 366 + 10) * 86400000
pdl_in_window = time >= last_bar_time - pdl_lookback_ms
pwl_in_window = time >= last_bar_time - pwl_lookback_ms
pml_in_window = time >= last_bar_time - pml_lookback_ms
pyl_in_window = time >= last_bar_time - pyl_lookback_ms

new_day   = timeframe.change("D")
new_week  = timeframe.change("W")
new_month = timeframe.change("M")
new_year  = timeframe.change("12M")

// Yearly is the exception: intraday charts rarely load a full year, so last year's high/low and this year's open come
// from one request on the yearly timeframe. y_h / y_l (this year so far) are only read on the last bar, where they hold
// no future data. y_o is fixed from the year's first bar, so it holds no future data either.
[y_ph, y_pl, y_h, y_l, y_o] = request.security(syminfo.tickerid, "12M", [high[1], low[1], high, low, open], lookahead = barmerge.lookahead_on)

track_hl(hl_track t, bool is_new) =>
    if is_new
        t.ph   := t.full ? t.h : na
        t.pl   := t.full ? t.l : na
        t.full := bar_index > 0
        t.h    := high
        t.l    := low
    else
        t.h := math.max(nz(t.h, high), high)
        t.l := math.min(nz(t.l, low), low)

if show_pdl
    track_hl(d_track, new_day)
if show_pwl
    track_hl(w_track, new_week)
if show_pml
    track_hl(m_track, new_month)
if show_pyl
    y_track.ph := y_ph
    y_track.pl := y_pl
// ---------------------------------------- Variables & Constants --------------------------------------------------


// ---------------------------------------- Core Logic --------------------------------------------------
// PERF (all drawings): line ends are no longer moved on every bar. They are set when a line stops
// (broken / cut off / session over) and, for lines still running, once on the last bar.

del_kz(kz k) =>
    if k._box.size() > max_days
        k._box.pop().delete()
    if k._hi.size() > max_days
        k._hi.pop()
        k._lo.pop()
        k._hi_valid.pop()
        k._lo_valid.pop()
    if k._hi_line.size() > max_days
        k._hi_line.pop().delete()
        k._lo_line.pop().delete()
    if k._md_line.size() > max_days
        k._md_line.pop().delete()


manage_kz(kz k, bool use, bool t, bool t_prev, color c, string box_txt, bool show_box, bool show_txt) =>
    if use
        bool draw_pv = show_pivots and not k.is_session

        if t and not t_prev
            // A new session starts. With 'Most Recent', the previous session's lines stop at the bar before this one.
            if ext_current and k._hi.size() > 0
                if draw_pv
                    if ext_past or k._hi_valid.get(0)
                        k._hi_line.get(0).set_x2(prev_time)
                    if ext_past or k._lo_valid.get(0)
                        k._lo_line.get(0).set_x2(prev_time)
                if show_md
                    k._md_line.get(0).set_x2(prev_time)

            if show_box
                color bc = color.new(c, k.is_session ? box_transparency_ss : box_transparency_kz)
                color tc = color.new(c, k.is_session ? text_transparency_ss : text_transparency_kz)
                k._box.unshift(box.new(time, high, time, low, xloc = xloc.bar_time, border_color = k.is_session ? color(na) : bc, bgcolor = bc, text = show_txt ? box_txt : na, text_color = tc))

            k._hi.unshift(high)
            k._lo.unshift(low)
            k._hi_valid.unshift(true)
            k._lo_valid.unshift(true)

            if draw_pv
                k._hi_line.unshift(line.new(time, high, time, high, xloc = xloc.bar_time, style = kzp_style, color = c, width = kzp_width))
                k._lo_line.unshift(line.new(time, low, time, low, xloc = xloc.bar_time, style = kzp_style, color = c, width = kzp_width))
            if show_md
                float mid0 = math.avg(high, low)
                k._md_line.unshift(line.new(time, mid0, time, mid0, xloc = xloc.bar_time, style = kzm_style, color = c, width = kzm_width))

            del_kz(k)

        else if k._hi.size() > 0
            if t
                // Inside the session: drawings are only touched when a new high/low prints
                if high > k._hi.get(0)
                    k._hi.set(0, high)
                    if show_box
                        k._box.get(0).set_top(high)
                    if draw_pv
                        k._hi_line.get(0).set_xy1(time, high)
                        k._hi_line.get(0).set_xy2(time, high)
                if low < k._lo.get(0)
                    k._lo.set(0, low)
                    if show_box
                        k._box.get(0).set_bottom(low)
                    if draw_pv
                        k._lo_line.get(0).set_xy1(time, low)
                        k._lo_line.get(0).set_xy2(time, low)
            else if t_prev
                // The session just ended: close the box and start the midpoint at its last bar
                if show_box
                    k._box.get(0).set_right(prev_time)
                if show_md
                    float mid1 = math.avg(k._hi.get(0), k._lo.get(0))
                    k._md_line.get(0).set_xy1(prev_time, mid1)
                    k._md_line.get(0).set_y2(mid1)

        // Broken / cut-off pivots. Session levels are only checked for the newest session (they only feed alerts).
        if show_pivots and k._hi.size() > 0
            bool cut = use_cutoff_kz and t_co_kz
            int chk_last = (ext_current or k.is_session) ? 0 : k._hi.size() - 1
            for i = 0 to chk_last
                if k._hi_valid.get(i)
                    bool hi_broke = high > k._hi.get(i)
                    if hi_broke or cut
                        k._hi_valid.set(i, false)
                        if draw_pv
                            k._hi_line.get(i).set_x2(time)
                        if hi_broke and use_alerts and i == 0
                            alert("Broke " + k._title + " High", alert.freq_once_per_bar)
                if k._lo_valid.get(i)
                    bool lo_broke = low < k._lo.get(i)
                    if lo_broke or cut
                        k._lo_valid.set(i, false)
                        if draw_pv
                            k._lo_line.get(i).set_x2(time)
                        if lo_broke and use_alerts and i == 0
                            alert("Broke " + k._title + " Low", alert.freq_once_per_bar)

        // Last bar (and every realtime update): bring everything still running up to the current bar
        if barstate.islast and k._hi.size() > 0
            if t
                if show_box
                    k._box.get(0).set_right(time)
                if show_md
                    float mid2 = math.avg(k._hi.get(0), k._lo.get(0))
                    k._md_line.get(0).set_xy1(time, mid2)
                    k._md_line.get(0).set_y2(mid2)
            if draw_pv or show_md
                int ext_last = ext_current ? 0 : k._hi.size() - 1
                for i = 0 to ext_last
                    if draw_pv
                        if ext_past or k._hi_valid.get(i)
                            k._hi_line.get(i).set_x2(time)
                        if ext_past or k._lo_valid.get(i)
                            k._lo_line.get(i).set_x2(time)
                    if show_md
                        k._md_line.get(i).set_x2(time)


vline(bool use, bool t, bool t_prev, line[] arr, color col, bool alrt) =>
    if use
        bool t_start = t and not t_prev
        if t_start or (t_prev and not t)
            arr.unshift(line.new(bar_index, high*1.0001, bar_index, low, style = vl_style, width = vl_width, extend = extend.both, color = col))
            if alrt
                alert(t_start ? "SB session started" : "SB session ended", alert.freq_once_per_bar)
            if arr.size()/2 > vl_limit
                arr.pop().delete()
        else if vl_clear and not t and arr.size() > 0
            while arr.size() > 0
                arr.pop().delete()


hz_line(bool use, bool t, bool t_prev, hz h, string txt, color col) =>
    if use
        // The size check has its own 'if' before get() (Pine v5 evaluated both sides of 'and'; v6 doesn't, but this is clearer)
        bool running = false
        if h.DONE.size() > 0
            running := not h.DONE.get(0)

        if t and not t_prev
            // The previous line last extended on the bar before this open
            if running
                h.LN.get(0).set_x2(bar_index - 1)
                h.LB.get(0).set_x(bar_index - 1)
                h.DONE.set(0, true)
            h.LN.unshift(line.new(bar_index, open, bar_index, open, style = hz_style, width = hz_width, color = col))
            h.LB.unshift(label.new(bar_index, open, txt, style = label.style_label_left, color = transparent, textcolor = col, size = lbl_size))
            h.DONE.unshift(false)
            if (not show_prev_op_2 and h.LN.size() > 1) or (h.LN.size() > max_days)
                h.DONE.pop()
                h.LN.pop().delete()
                h.LB.pop().delete()
        else if not t and running
            if use_cutoff and t_co
                h.LN.get(0).set_x2(bar_index)
                h.LB.get(0).set_x(bar_index)
                h.DONE.set(0, true)
            else if barstate.islast
                h.LN.get(0).set_x2(bar_index)
                h.LB.get(0).set_x(bar_index)


get_target_time(_time) =>
    int _hour = math.round(str.tonumber(str.substring(_time,0,2)))
    int _minute = math.round(str.tonumber(str.substring(_time,2,4)))
    timestamp(gmt_tz,year, month, dayofmonth, _hour,_minute)

// Plot a vertical line at a specific time (bar_step = time[1] - time[2] estimates the bar duration)
plot_line_at_time(int target_time, quater_cycles qc, color _color) =>
    // int(): v6 keeps the fraction of a division, and line x positions are whole bars
    int bar_offset = int((target_time - time) / bar_step)
    qc._line.unshift(line.new(bar_index + bar_offset, close, bar_index + bar_offset, close, xloc=xloc.bar_index, color=_color, width=qt_width, style=qt_style, extend=extend.both))

qc_vline(bool use, quater_cycles cycle, bool in_range, bool in_range_prev, color _color, bool alert_q1, bool alert_q2, bool alert_q3, bool alert_q4) =>
    if use
        max_line_per_cycle = 5
        if in_range and not in_range_prev
            // PERF: quarter times are parsed once per cycle instead of on every bar
            cycle._ts.clear()
            cycle._ts.push(get_target_time(cycle.q1))
            cycle._ts.push(get_target_time(cycle.q2))
            cycle._ts.push(get_target_time(cycle.q3))
            cycle._ts.push(get_target_time(cycle.q4_s))
            for ts in cycle._ts
                plot_line_at_time(ts, cycle, _color)
            plot_line_at_time(get_target_time(cycle.q4_e), cycle, _color)
            if(cycle._line.size()/max_line_per_cycle > qt_max)
                for i = 1 to max_line_per_cycle by 1
                    cycle._line.pop().delete()
        else if qt_clear and not in_range and in_range_prev and cycle._line.size() >= max_line_per_cycle
            for i = 1 to max_line_per_cycle by 1
                cycle._line.pop().delete()

        if in_range and cycle._ts.size() == 4
            if(time == cycle._ts.get(0) and alert_q1)
                alert("Q1 started", alert.freq_once_per_bar)
            else if(time == cycle._ts.get(1) and alert_q2)
                alert("Q2 started", alert.freq_once_per_bar)
            else if(time == cycle._ts.get(2) and alert_q3)
                alert("Q3 started", alert.freq_once_per_bar)
            else if(time == cycle._ts.get(3) and alert_q4)
                alert("Q4 started", alert.freq_once_per_bar)


// ---- Previous Day / Week / Month High & Low ----
// Name of entry i: "D" (newest), "2D", "3D" ... / "W", "2W" ... / "M", "2M" ...
pdl_name(prev_lvl p, int i) =>
    int ago = p.period - p.per_no.get(i) + 1
    (ago <= 1 ? "" : str.tostring(ago)) + p.tf

pdl_text(prev_lvl p, int i) =>
    "P" + pdl_name(p, i) + (p.is_high ? " High " : " Low ") + (p.hit.get(i) ? "✖" : "✔")

pdl_remove(prev_lvl p, int i) =>
    p.lvl.remove(i)
    p.hit.remove(i)
    p.hit_time.remove(i)
    p.per_no.remove(i)
    p.ln.remove(i).delete()
    p.lb.remove(i).delete()

// Recompute the nearest unbroken level (lowest high / highest low) after levels are added or removed
pdl_refresh(prev_lvl p) =>
    float best = na
    int n = p.lvl.size()
    if n > 0
        for i = 0 to n - 1
            if not p.hit.get(i)
                float v = p.lvl.get(i)
                if na(best) or (p.is_high ? v < best : v > best)
                    best := v
    p.nearest := best

pdl_add(prev_lvl p, float level) =>
    p.lvl.unshift(level)
    p.hit.unshift(false)
    p.hit_time.unshift(0)
    p.per_no.unshift(p.period)
    p.ln.unshift(line.new(time, level, time, level, xloc = xloc.bar_time, style = pdl_style, width = pdl_width, color = p.col))
    p.lb.unshift(label.new(time, level, pdl_text(p, 0), xloc = xloc.bar_time, style = label.style_label_left, color = pdl_bg ? p.col : transparent, textcolor = pdl_bg ? color.white : p.col, size = lbl_size))
    if p.ln.size() > p.max_n
        pdl_remove(p, p.ln.size() - 1)

// Remove levels that were broken more than 'hide_ms' ago
pdl_purge(prev_lvl p) =>
    if pdl_hide_mit and p.ln.size() > 0
        for i = p.ln.size() - 1 to 0
            if p.hit.get(i)
                if time >= p.hit_time.get(i) + p.hide_ms
                    pdl_remove(p, i)

// New period: every existing level is one period older (PD -> P2D, PW -> P2W, ...)
pdl_roll(prev_lvl p) =>
    if p.ln.size() > 0
        // The current period's level always runs to the end of its period; if it was already broken it stops there
        if p.per_no.get(0) == p.period and p.hit.get(0)
            p.ln.get(0).set_x2(prev_time)
            p.lb.get(0).set_x(prev_time)
    pdl_purge(p)
    p.period := p.period + 1
    int n = p.ln.size()
    if n > 0
        for i = 0 to n - 1
            p.lb.get(i).set_text(pdl_text(p, i))

pdl_mark_hit(prev_lvl p, int i, bool alrt) =>
    p.hit.set(i, true)
    p.hit_time.set(i, time)
    color cl = color.new(p.col, 40)
    line pl = p.ln.get(i)
    label pb = p.lb.get(i)
    pl.set_color(cl)
    if p.per_no.get(i) != p.period
        // Older levels stop where they were broken; the current one keeps running until its period ends
        pl.set_x2(time)
        pb.set_x(time)
    pb.set_color(pdl_bg ? cl : transparent)
    pb.set_textcolor(pdl_bg ? color.white : cl)
    pb.set_size(pdl_bg ? lbl_size : size.tiny)
    pb.set_text(pdl_text(p, i))
    if alrt and pdl_alerts
        alert("Previous " + pdl_name(p, i) + (p.is_high ? " High" : " Low") + " Broken 🔥🔥", alert.freq_once_per_bar)

pdl_check(prev_lvl p) =>
    // PERF: one comparison per bar; the loop only runs when price reaches the nearest unbroken level
    if p.is_high ? high >= p.nearest : low <= p.nearest
        for i = 0 to p.ln.size() - 1
            if not p.hit.get(i)
                float lv = p.lvl.get(i)
                if p.is_high ? high >= lv : low <= lv
                    pdl_mark_hit(p, i, true)
        pdl_refresh(p)

// Last bar, yearly only: catch a break of the current PY level that happened this year before the chart's first bar
pdl_ytd_check(prev_lvl p, float ytd) =>
    if p.ln.size() > 0 and not na(ytd)
        if p.per_no.get(0) == p.period and not p.hit.get(0)
            if p.is_high ? ytd >= p.lvl.get(0) : ytd <= p.lvl.get(0)
                pdl_mark_hit(p, 0, false)
                pdl_refresh(p)

// Last bar: the current period's level and every unbroken one run up to the current bar
pdl_extend(prev_lvl p) =>
    int n = p.ln.size()
    if n > 0
        for i = 0 to n - 1
            if p.per_no.get(i) == p.period or not p.hit.get(i)
                p.ln.get(i).set_x2(time)
                p.lb.get(i).set_x(time)

pdl_run(prev_lvl hi, prev_lvl lo, hl_track tr, bool is_new) =>
    if is_new and not na(tr.ph)
        pdl_roll(hi)
        pdl_roll(lo)
        pdl_add(hi, tr.ph)
        pdl_add(lo, tr.pl)
        pdl_refresh(hi)
        pdl_refresh(lo)
    pdl_check(hi)
    pdl_check(lo)
    if barstate.islast
        pdl_purge(hi)
        pdl_purge(lo)
        pdl_extend(hi)
        pdl_extend(lo)

// A level sitting exactly on a higher-timeframe level is dropped so the higher one shows instead.
// keep_cur keeps the current period's level anyway (used for PD, as in the original).
pdl_dedupe(prev_lvl lower, prev_lvl higher, bool keep_cur) =>
    if lower.ln.size() > 0 and higher.lvl.size() > 0
        for i = lower.ln.size() - 1 to 0
            if not keep_cur or lower.per_no.get(i) != lower.period
                if higher.lvl.includes(lower.lvl.get(i))
                    pdl_remove(lower, i)
        pdl_refresh(lower)


// Higher timeframes first, so each lower one can be de-duplicated against them
if show_pyl and pyl_tf_ok and pyl_in_window
    if not py_seeded and not na(y_ph)
        py_seeded := true
        if not new_year
            // The last new year is usually before the chart's first bar, so last year's levels start here instead
            pdl_add(py_high_lv, y_ph)
            pdl_add(py_low_lv, y_pl)
            pdl_refresh(py_high_lv)
            pdl_refresh(py_low_lv)
    pdl_run(py_high_lv, py_low_lv, y_track, new_year)
    if barstate.islast
        pdl_ytd_check(py_high_lv, y_h)
        pdl_ytd_check(py_low_lv, y_l)

if show_pml and pml_tf_ok and pml_in_window
    pdl_run(pm_high_lv, pm_low_lv, m_track, new_month)
    if new_month and show_pyl and pyl_tf_ok
        pdl_dedupe(pm_high_lv, py_high_lv, false)
        pdl_dedupe(pm_low_lv, py_low_lv, false)

if show_pwl and pwl_tf_ok and pwl_in_window
    pdl_run(pw_high_lv, pw_low_lv, w_track, new_week)
    if (new_week or new_month) and show_pml and pml_tf_ok
        pdl_dedupe(pw_high_lv, pm_high_lv, false)
        pdl_dedupe(pw_low_lv, pm_low_lv, false)

if show_pdl and pdl_tf_ok and pdl_in_window
    pdl_run(pd_high_lv, pd_low_lv, d_track, new_day)
    if new_day and show_pwl and pwl_tf_ok
        pdl_dedupe(pd_high_lv, pw_high_lv, true)
        pdl_dedupe(pd_low_lv, pw_low_lv, true)

// ---- Day / Week / Month / Year opening price lines ----
open_new(open_lvl p, float o) =>
    // The previous line stops at the end of its period
    if p.ln.size() > 0
        p.ln.get(0).set_x2(prev_time)
        p.lb.get(0).set_x(prev_time)
    p.o := o
    p.ln.unshift(line.new(time, o, time, o, xloc = xloc.bar_time, style = op_style, width = op_width, color = p.col))
    p.lb.unshift(label.new(time, o, p.tf + " OPEN", xloc = xloc.bar_time, style = label.style_label_left, color = transparent, textcolor = p.col, size = lbl_size))
    if p.ln.size() > max_op
        p.ln.pop().delete()
        p.lb.pop().delete()

open_run(open_lvl p, bool is_new, float o) =>
    if is_new and not na(o)
        open_new(p, o)
    if p.ln.size() > 0
        if barstate.islast
            p.ln.get(0).set_x2(time)
            p.lb.get(0).set_x(time)
        // PERF: alerts only fire in realtime, so the cross check is skipped on history. At most one alert per hour per open.
        if use_op_alerts and barstate.isrealtime and time - p.alert_t >= 3600000
            if (prev_high < p.o and high >= p.o) or (prev_low > p.o and low <= p.o)
                alert("Price hit " + p.tf + " Opening Price", alert.freq_once_per_bar)
                p.alert_t := time


if tf_ok
    if show_y_open
        if not y_open_seeded and not na(y_o)
            y_open_seeded := true
            if not new_year
                // The year usually started before the chart's first bar, so its open line starts here instead
                open_new(y_open_lv, y_o)
        open_run(y_open_lv, new_year, y_o)
    // bar_index > 0: the chart's first bar is usually mid-period, so its open isn't the period's open
    if show_m_open
        open_run(m_open_lv, new_month and bar_index > 0, open)
    if show_w_open
        open_run(w_open_lv, new_week and bar_index > 0, open)
    if show_d_open
        open_run(d_open_lv, new_day and bar_index > 0, open)


// ---- Day / Week / Month / Year dividers ----
div_line(bool is_new, line[] arr, color col) =>
    if is_new
        arr.unshift(line.new(bar_index, high * 1.0001, bar_index, low, style = sep_style, width = sep_width, extend = extend.both, color = col))
        if arr.size() > max_sep
            arr.pop().delete()

// bar_index > 0: the chart's first bar is usually mid-period, not a real boundary. Year is drawn last so it sits on top.
if tf_ok and bar_index > 0
    if show_d_div
        div_line(new_day, d_div, pdl_color)
    if show_w_div
        div_line(new_week, w_div, pwl_color)
    if show_m_div
        div_line(new_month, m_div, pml_color)
    if show_y_div
        div_line(new_year, y_div, pyl_color)

if qc_tf_ok and in_window
    qc_vline(use_lc,  london_cycle, t_l_c,  t_l_c[1],  lc_color,  alert_lc_q1, alert_lc_q2, alert_lc_q3, alert_lc_q4)
    qc_vline(use_nyc, ny_cycle,     t_ny_c, t_ny_c[1], nyc_color, alert_ny_q1, alert_ny_q2, alert_ny_q3, alert_ny_q4)

if tf_ok and in_window
    manage_kz(as_kz, use_asia_kz,   t_as_kz, t_as_kz[1], as_color_kz,   as_txt_kz,   show_kz, show_kz_text)
    manage_kz(lo_kz, use_london_kz, t_lo_kz, t_lo_kz[1], lo_color_kz,   lo_txt_kz,   show_kz, show_kz_text)
    manage_kz(na_kz, use_nyam_kz,   t_na_kz, t_na_kz[1], nyam_color_kz, nyam_txt_kz, show_kz, show_kz_text)
    manage_kz(np_kz, use_nypm_kz,   t_np_kz, t_np_kz[1], nypm_color_kz, nypm_txt_kz, show_kz, show_kz_text)

    manage_kz(as_ss, use_asia_ss,   t_as_ss, t_as_ss[1], as_color_ss, as_txt_ss, show_ss, show_ss_text)
    manage_kz(lo_ss, use_london_ss, t_lo_ss, t_lo_ss[1], lo_color_ss, lo_txt_ss, show_ss, show_ss_text)
    manage_kz(na_ss, use_ny_ss,     t_na_ss, t_na_ss[1], na_color_ss, ny_txt_ss, show_ss, show_ss_text)
    manage_kz(nl_ss, use_nylu_ss,   t_nl_ss, t_nl_ss[1], nl_color_ss, nl_txt_ss, show_ss, show_ss_text)
    manage_kz(np_ss, use_nypm_ss,   t_np_ss, t_np_ss[1], np_color_ss, np_txt_ss, show_ss, show_ss_text)

    vline(use_v1, t_v1, t_v1[1], v1_line, v1_color, v1_alert)
    vline(use_v2, t_v2, t_v2[1], v2_line, v2_color, v2_alert)
    vline(use_v3, t_v3, t_v3[1], v3_line, v3_color, v3_alert)

    hz_line(use_h1, t_h1, t_h1[1], hz_1, h1_text, h1_color)
    hz_line(use_h2, t_h2, t_h2[1], hz_2, h2_text, h2_color)
    hz_line(use_h3, t_h3, t_h3[1], hz_3, h3_text, h3_color)
    hz_line(use_h4, t_h4, t_h4[1], hz_4, h4_text, h4_color)


// ---- Order Blocks (LuxAlgo Smart Money Concepts logic, as in "ICT HTF FVG & Order Blocks") ----
// PERF changes vs the original:
//  - Broken blocks: the original's delete loop used array.indexof() by type, so it only ever checked the newest block of
//    each type; broken older blocks were never removed and the lists grew all session (O(n^2) work per bar). Now every
//    broken block is removed, and the check is one comparison per bar unless close passes the nearest block edge.
//  - The volatility filter reads the per-bar ATR history (the original read it from a variable local to a conditionally
//    called function, i.e. ATR at previous detections rather than previous bars).
//  - The search back to the swing point is capped at the 500-bar history buffer, which is only kept for the 4 series it reads.
//  - At most OB_KEEP unbroken blocks are remembered per list; only the newest few are drawn.
OB_KEEP = 200

type ob_set
    float[] top
    float[] btm
    int[]   left
    int[]   typ         // 1 = bullish, -1 = bearish
    float   bull_lvl    // highest bullish bottom: a bullish block can only break when close drops below this
    float   bear_lvl    // lowest bearish top: a bearish block can only break when close rises above this
    box[]   boxes       // pre-created display boxes, positioned on the last bar only

ob_new(int nbox) =>
    box[] bxs = array.new_box()
    if nbox > 0
        for i = 1 to nbox
            bxs.push(box.new(na, na, na, na, xloc = xloc.bar_time))
    ob_set.new(array.new_float(), array.new_float(), array.new_int(), array.new_int(), na, na, bxs)

var iob_set = ob_new(show_iob ? iob_showlast : 0)
var sob_set = ob_new(show_ob ? ob_showlast : 0)

ob_atr       = ta.atr(200)
ob_cmean     = ta.cum(high - low) / bar_index
ob_threshold = ob_filter == 'Atr' ? ob_atr : ob_cmean
max_bars_back(ob_threshold, 500)
max_bars_back(high, 500)
max_bars_back(low, 500)
max_bars_back(time, 500)

// Recompute the nearest edges after blocks are removed
ob_refresh(ob_set s) =>
    float bull = na
    float bear = na
    int sz = s.typ.size()
    if sz > 0
        for i = 0 to sz - 1
            if s.typ.get(i) == 1
                bull := na(bull) ? s.btm.get(i) : math.max(bull, s.btm.get(i))
            else
                bear := na(bear) ? s.top.get(i) : math.min(bear, s.top.get(i))
    s.bull_lvl := bull
    s.bear_lvl := bear

ob_add(ob_set s, float t, float b, int left, int typ) =>
    s.top.unshift(t)
    s.btm.unshift(b)
    s.left.unshift(left)
    s.typ.unshift(typ)
    if s.typ.size() > OB_KEEP
        s.top.pop()
        s.btm.pop()
        s.left.pop()
        s.typ.pop()
        ob_refresh(s)
    else if typ == 1
        s.bull_lvl := na(s.bull_lvl) ? b : math.max(s.bull_lvl, b)
    else
        s.bear_lvl := na(s.bear_lvl) ? t : math.min(s.bear_lvl, t)

// Order block coordinates: the least volatile candle with the lowest low (bullish) / highest high (bearish) since the swing
ob_coord(bool use_max, int loc, ob_set s) =>
    float mn = 99999999.
    float mx = 0.
    int idx = 1
    int last_i = math.min(bar_index - loc - 1, 499)
    if use_max
        for i = 1 to last_i
            if (high[i] - low[i]) < ob_threshold[i] * 2
                mx := math.max(high[i], mx)
                mn := mx == high[i] ? low[i] : mn
                idx := mx == high[i] ? i : idx
    else
        for i = 1 to last_i
            if (high[i] - low[i]) < ob_threshold[i] * 2
                mn := math.min(low[i], mn)
                mx := mn == low[i] ? high[i] : mx
                idx := mn == low[i] ? i : idx
    ob_add(s, mx, mn, time[idx], use_max ? -1 : 1)

// Remove broken blocks: bullish when close < bottom, bearish when close > top
ob_prune(ob_set s) =>
    if close < s.bull_lvl or close > s.bear_lvl
        int sz = s.typ.size()
        if sz > 0
            for i = sz - 1 to 0
                int t = s.typ.get(i)
                if (t == 1 and close < s.btm.get(i)) or (t == -1 and close > s.top.get(i))
                    s.top.remove(i)
                    s.btm.remove(i)
                    s.left.remove(i)
                    s.typ.remove(i)
        ob_refresh(s)

ob_display(ob_set s, bool swing) =>
    int nb = s.boxes.size()
    int sz = s.typ.size()
    if nb > 0
        for i = 0 to nb - 1
            box b = s.boxes.get(i)
            if i < sz
                int t = s.typ.get(i)
                b.set_lefttop(s.left.get(i), s.top.get(i))
                b.set_rightbottom(s.left.get(i), s.btm.get(i))
                b.set_extend(extend.right)
                color css = na
                if ob_theme == 'Monochrome'
                    css := t == 1 ? color.new(#b2b5be, 80) : color.new(#5d606b, 80)
                    b.set_border_color(swing ? (t == 1 ? #b2b5be : #5d606b) : css)
                else
                    css := swing ? (t == 1 ? bull_ob_css : bear_ob_css) : (t == 1 ? ibull_ob_css : ibear_ob_css)
                    b.set_border_color(css)
                b.set_bgcolor(css)
            else
                // fewer blocks than boxes (e.g. one broke in realtime): hide the spare box
                b.set_lefttop(na, na)
                b.set_rightbottom(na, na)

// Swings detection/measurements (verbatim)
ob_swings(int len) =>
    var os = 0
    upper = ta.highest(len)
    lower = ta.lowest(len)
    os := high[len] > upper ? 0 : low[len] < lower ? 1 : os[1]
    top = os == 0 and os[1] != 0 ? high[len] : 0
    btm = os == 1 and os[1] != 1 ? low[len] : 0
    [top, btm]

var float ob_top_y  = 0.
var int   ob_top_x  = 0
var float ob_btm_y  = 0.
var int   ob_btm_x  = 0
var float ob_itop_y = 0.
var int   ob_itop_x = 0
var float ob_ibtm_y = 0.
var int   ob_ibtm_x = 0
var bool  ob_top_cross  = true
var bool  ob_btm_cross  = true
var bool  ob_itop_cross = true
var bool  ob_ibtm_cross = true

var bool bull_concordant = true
var bool bear_concordant = true
if ifilter_confluence
    bull_concordant := high - math.max(close, open) > math.min(close, open - low)
    bear_concordant := high - math.max(close, open) < math.min(close, open - low)

[sw_top, sw_btm]   = ob_swings(50)
[isw_top, isw_btm] = ob_swings(5)

// bool(): v6 no longer treats a number as true/false by itself (0 and na -> false, as before)
if bool(sw_top)
    ob_top_cross := true
    ob_top_y     := sw_top
    ob_top_x     := bar_index - 50
if bool(isw_top)
    ob_itop_cross := true
    ob_itop_y     := isw_top
    ob_itop_x     := bar_index - 5
if bool(sw_btm)
    ob_btm_cross := true
    ob_btm_y     := sw_btm
    ob_btm_x     := bar_index - 50
if bool(isw_btm)
    ob_ibtm_cross := true
    ob_ibtm_y     := isw_btm
    ob_ibtm_x     := bar_index - 5

// Crosses are taken every bar (after the swing levels update), as in the original
ob_x_itop = ta.crossover(close, ob_itop_y)
ob_x_top  = ta.crossover(close, ob_top_y)
ob_x_ibtm = ta.crossunder(close, ob_ibtm_y)
ob_x_btm  = ta.crossunder(close, ob_btm_y)

// Internal bullish / swing bullish / internal bearish / swing bearish order blocks
if show_iob and ob_x_itop and ob_itop_cross and ob_top_y != ob_itop_y and bull_concordant
    ob_coord(false, ob_itop_x, iob_set)
    ob_itop_cross := false
if show_ob and ob_x_top and ob_top_cross
    ob_coord(false, ob_top_x, sob_set)
    ob_top_cross := false
if show_iob and ob_x_ibtm and ob_ibtm_cross and ob_btm_y != ob_ibtm_y and bear_concordant
    ob_coord(true, ob_ibtm_x, iob_set)
    ob_ibtm_cross := false
if show_ob and ob_x_btm and ob_btm_cross
    ob_coord(true, ob_btm_x, sob_set)
    ob_btm_cross := false

if show_iob
    ob_prune(iob_set)
    if barstate.islast
        ob_display(iob_set, false)
if show_ob
    ob_prune(sob_set)
    if barstate.islast
        ob_display(sob_set, true)


// ---- HTF Candles (PO3) ----
// The latest 1-4 candles of a higher timeframe drawn to the right of price, with the current candle's open / high / low
// projected back to where they formed, its OHLC prices, and a table with the time left and the range.
// PERF: the candles come from one small data request on the last bar only. The only per-bar work is remembering where the
// current candle opened and made its high / low, and only on the recent bars that can belong to it.
po3_sec        = timeframe.in_seconds(po3_tf)
var po3_ok     = show_po3 and po3_sec > tf_sec
var po3_track  = po3_ok and (po3_open_show or po3_hl_show)
var po3_win_ms = (2 * po3_sec + 3 * 86400) * 1000
var po3_w      = po3_size == 'Small' ? 3 : po3_size == 'Large' ? 9 : 5   // candle width in bars (odd, so the wick is centred)
po3_new        = timeframe.change(po3_tf)

var int   po3_ob = na   // bar_index where the current HTF candle opened (or where tracking started, if later)
var float po3_hh = na   // its high / low so far, and the bar_index where each formed
var int   po3_hb = na
var float po3_ll = na
var int   po3_lb = na
if po3_track and time >= last_bar_time - po3_win_ms
    if po3_new or na(po3_ob)
        po3_ob := bar_index
        po3_hh := high
        po3_hb := bar_index
        po3_ll := low
        po3_lb := bar_index
    else
        if high > po3_hh
            po3_hh := high
            po3_hb := bar_index
        if low < po3_ll
            po3_ll := low
            po3_lb := bar_index

// Drawings are created on the last bar, so they are never among the oldest (which TradingView removes first at the limit)
var line[]  po3_proj = array.new_line()     // open, high, low projections
var line[]  po3_wick = array.new_line()
var box[]   po3_body = array.new_box()
var label[] po3_px   = array.new_label()    // open, high, low, close prices
var table   po3_tbl  = na

po3_tf_text(string tf) =>
    int s = timeframe.in_seconds(tf)
    string r = tf
    if s < 3600
        r := str.tostring(s / 60) + "m"
    else if s < 86400
        r := str.tostring(s / 3600) + "H"
    else if tf == "D" or tf == "W" or tf == "M"
        r := "1" + tf
    r

po3_timer(int ms) =>
    int s  = math.max(int(ms / 1000), 0)
    int d  = int(s / 86400)
    int hh = int((s % 86400) / 3600)
    int mm = int((s % 3600) / 60)
    int ss = s % 60
    string hms = str.format("{0,number,00}:{1,number,00}:{2,number,00}", hh, mm, ss)
    d > 0 ? str.tostring(d) + "d " + hms : hms

po3_table_pos(string v, string h) =>
    switch v
        'Top'    => h == 'Left' ? position.top_left : h == 'Center' ? position.top_center : position.top_right
        'Bottom' => h == 'Left' ? position.bottom_left : h == 'Center' ? position.bottom_center : position.bottom_right
        => h == 'Left' ? position.middle_left : h == 'Center' ? position.middle_center : position.middle_right

// Candle j (0 = leftmost slot) with its left edge at bar x_left; hidden when there is no data
po3_set_candle(int j, float o, float h, float l, float c, int x_left) =>
    box  b = po3_body.get(j)
    line w = po3_wick.get(j)
    if na(o) or na(c)
        b.set_lefttop(na, na)
        b.set_rightbottom(na, na)
        w.set_xy1(na, na)
        w.set_xy2(na, na)
    else
        bool up = c >= o
        int  xc = x_left + int((po3_w - 1) / 2)
        b.set_lefttop(x_left, math.max(o, c))
        b.set_rightbottom(x_left + po3_w - 1, math.min(o, c))
        b.set_bgcolor(up ? po3_body_up : po3_body_dn)
        b.set_border_color(up ? po3_border_up : po3_border_dn)
        w.set_xy1(xc, h)
        w.set_xy2(xc, l)
        w.set_color(up ? po3_wick_up : po3_wick_dn)

// Dotted projection k from bar x1 to bar x2 at price y; hidden when off or without data
po3_set_proj(int k, bool use, int x1, int x2, float y, color col, int width) =>
    line ln = po3_proj.get(k)
    if use and not na(x1) and not na(y)
        ln.set_xy1(x1, y)
        ln.set_xy2(x2, y)
        ln.set_color(col)
        ln.set_width(width)
    else
        ln.set_xy1(na, na)
        ln.set_xy2(na, na)

po3_set_px(int k, int x, float y) =>
    label lb = po3_px.get(k)
    if po3_px_show and not na(y)
        lb.set_xy(x, y)
        lb.set_text(str.tostring(y, format.mintick))
    else
        lb.set_xy(na, na)

if po3_ok and barstate.islast
    // Current candle (pa_), then 1 (pb_), 2 (pc_) and 3 (pd_) candles back. On the last bar the current candle's
    // values are its values so far, so lookahead_on holds no future data here.
    [pa_o, pa_h, pa_l, pa_c, pa_tc, pb_o, pb_h, pb_l, pb_c, pc_o, pc_h, pc_l, pc_c, pd_o, pd_h, pd_l, pd_c] = request.security(syminfo.tickerid, po3_tf, [open, high, low, close, time_close, open[1], high[1], low[1], close[1], open[2], high[2], low[2], close[2], open[3], high[3], low[3], close[3]], lookahead = barmerge.lookahead_on, calc_bars_count = 10)

    if po3_body.size() == 0
        // created at the current bar and positioned (or hidden) right below
        for k = 1 to 3
            po3_proj.push(line.new(bar_index, close, bar_index, close, style = line.style_dotted))
        for k = 1 to po3_count
            po3_wick.push(line.new(bar_index, close, bar_index, close))
        for k = 1 to po3_count
            po3_body.push(box.new(bar_index, close, bar_index, close, border_width = 1))
        for k = 1 to 4
            po3_px.push(label.new(bar_index, close, "", style = label.style_label_left, color = transparent, textcolor = po3_px_col, size = po3_px_size))
        if po3_tbl_show
            po3_tbl := table.new(po3_table_pos(po3_tbl_v, po3_tbl_h), 1, 3, frame_color = po3_tbl_txt, frame_width = 1, border_color = po3_tbl_txt, border_width = 1)

    // Slots from the left; the current candle is always the rightmost
    int step  = po3_w + 2
    int x0    = bar_index + po3_offset
    int x_cur = x0 + (po3_count - 1) * step
    if po3_count >= 4
        po3_set_candle(po3_count - 4, pd_o, pd_h, pd_l, pd_c, x0 + (po3_count - 4) * step)
    if po3_count >= 3
        po3_set_candle(po3_count - 3, pc_o, pc_h, pc_l, pc_c, x0 + (po3_count - 3) * step)
    if po3_count >= 2
        po3_set_candle(po3_count - 2, pb_o, pb_h, pb_l, pb_c, x0 + (po3_count - 2) * step)
    po3_set_candle(po3_count - 1, pa_o, pa_h, pa_l, pa_c, x_cur)

    // Projections end at the current candle's wick. If its high / low formed before the tracked bars (very long
    // timeframes on small charts), the line starts where tracking started instead.
    int xc = x_cur + int((po3_w - 1) / 2)
    po3_set_proj(0, po3_open_show, po3_ob, xc, pa_o, po3_open_col, po3_open_w)
    po3_set_proj(1, po3_hl_show, po3_hh >= pa_h ? po3_hb : po3_ob, xc, pa_h, po3_hl_col, po3_hl_w)
    po3_set_proj(2, po3_hl_show, po3_ll <= pa_l ? po3_lb : po3_ob, xc, pa_l, po3_hl_col, po3_hl_w)

    int x_px = x_cur + po3_w
    po3_set_px(0, x_px, pa_o)
    po3_set_px(1, x_px, pa_h)
    po3_set_px(2, x_px, pa_l)
    po3_set_px(3, x_px, pa_c)

    if po3_tbl_show and not na(po3_tbl)
        float  rng  = pa_h - pa_l
        string rtxt = po3_range_unit == 'Ticks' ? str.tostring(math.round(rng / syminfo.mintick)) : str.tostring(rng, format.mintick)
        // The timer only updates when the script runs, i.e. on each new price tick
        table.cell(po3_tbl, 0, 0, po3_tf_text(po3_tf) + " CANDLE", text_color = po3_tbl_txt, bgcolor = po3_tbl_bg, text_size = size.tiny)
        table.cell(po3_tbl, 0, 1, na(pa_tc) ? "" : po3_timer(pa_tc - timenow), text_color = po3_tbl_txt, bgcolor = po3_tbl_bg, text_size = size.normal)
        table.cell(po3_tbl, 0, 2, "Range: " + rtxt, text_color = po3_tbl_txt, bgcolor = po3_tbl_bg, text_size = size.tiny)
// ---------------------------------------- Core Logic --------------------------------------------------
