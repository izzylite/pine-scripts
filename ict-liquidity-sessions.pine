//@version=6
indicator("ICT Liquidity & Sessions", "Liquidity & Sessions", true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)
// Sessions & killzones, previous D / W / M / Y highs & lows, D / W / M / Y opens and dividers, order blocks, and
// HTF candles (PO3).
// HTF FVG + IFVG is a separate indicator ("ICT HTF FVG", ict-htf-fvg.pine) so each stays under the 0.5 s limit.


// --------------------------------------- Constant Functions --------------------------------------------------
get_line_type(_style) =>
    result = switch _style
        'Solid' => line.style_solid
        'Dotted' => line.style_dotted
        'Dashed' => line.style_dashed
    result

get_size(x) =>
    result = switch x
        'Auto' => size.auto
        'Tiny' => size.tiny
        'Small' => size.small
        'Normal' => size.normal
        'Large' => size.large
        'Huge' => size.huge
// ---------------------------------------- Constant Functions --------------------------------------------------


// ---------------------------------------- Inputs --------------------------------------------------
var g_SETTINGS      = "Settings"
max_days            = input.int(20, "Session Drawing Limit", 1, tooltip = "Only this many drawings will be kept on the chart, for each selected drawing type (killzone boxes, pivot lines, open lines, etc.). Bars older than about 1.5x this many days are skipped so the script loads faster.", group = g_SETTINGS)
tf_limit            = input.timeframe("30", "Session Timeframe Limit", tooltip = "Drawings will not appear on timeframes greater than or equal to this", group = g_SETTINGS)
gmt_tz              = input.string('America/New_York', "Timezone", options = ['America/New_York','GMT-12','GMT-11','GMT-10','GMT-9','GMT-8','GMT-7','GMT-6','GMT-5','GMT-4','GMT-3','GMT-2','GMT-1','GMT+0','GMT+1','GMT+2','GMT+3','GMT+4','GMT+5','GMT+6','GMT+7','GMT+8','GMT+9','GMT+10','GMT+11','GMT+12','GMT+13','GMT+14'], tooltip = "Note GMT is not adjusted to reflect Daylight Saving Time changes", group = g_SETTINGS)
lbl_size            = get_size(input.string('Tiny', "Label Size", options = ['Auto', 'Tiny', 'Small', 'Normal', 'Large', 'Huge'], tooltip = "The size of all labels", group = g_SETTINGS))


var g_KZ            = "Killzones"
show_kz             = input.bool(true, "Show Killzone Boxes", inline = "KZ", group = g_KZ)
show_kz_text        = input.bool(false, "Display Text", inline = "KZ", group = g_KZ)
box_transparency_kz    = input.int(90, "Box Transparency", 0, 100, group = g_KZ)
text_transparency_kz   = input.int(50, "Text Transparency", 0, 100, group = g_KZ)

use_asia_kz            = input.bool(true, "", inline = "ASIA", group = g_KZ)
as_txt_kz              = input.string("Asia Killzone", "", inline = "ASIA", group = g_KZ)
asia_kz                = input.session("2000-0000", "", inline = "ASIA", group = g_KZ)
as_color_kz            = input.color(#2962ff, "", inline = "ASIA", group = g_KZ)

use_london_kz          = input.bool(true, "", inline = "LONDON", group = g_KZ)
lo_txt_kz              = input.string("London Killzone", "", inline = "LONDON", group = g_KZ)
london_kz              = input.session("0200-0500", "", inline = "LONDON", group = g_KZ)
lo_color_kz            = input.color(#388e3c, "", inline = "LONDON", group = g_KZ)

use_nyam_kz            = input.bool(true, "", inline = "NYAM", group = g_KZ)
nyam_txt_kz            = input.string("NY AM Killzone", "", inline = "NYAM", group = g_KZ)
nyam_kz                = input.session("0830-1100", "", inline = "NYAM", group = g_KZ)
nyam_color_kz          = input.color(#f57c00, "", inline = "NYAM", group = g_KZ)

use_nypm_kz            = input.bool(true, "", inline = "NYPM", group = g_KZ)
nypm_txt_kz            = input.string("NY PM Killzone", "", inline = "NYPM", group = g_KZ)
nypm_kz                = input.session("1330-1600", "", inline = "NYPM", group = g_KZ)
nypm_color_kz          = input.color(#9c27b0, "", inline = "NYPM", group = g_KZ)

use_cutoff_kz          = input.bool(false, "Drawing Cutoff Time", inline = "C0K", tooltip = "When enabled, all open killzone pivot lines will stop extending at this time", group = g_KZ)
cutoff_kz              = input.session("1600-1601", "", inline = "C0K", group = g_KZ)


var g_LABELS        = "Killzone Pivots"
show_pivots         = input.bool(true, "Show Pivots", inline = "PV", group = g_LABELS)
use_alerts          = input.bool(true, "Alert Broken Pivots", inline = "PV", group = g_LABELS)
show_midpoints      = input.bool(false, "Show Pivot Midpoints", group = g_LABELS)
ext_pivots          = input.string("Until Mitigated", "Extend Pivots...", options = ['Until Mitigated', 'Past Mitigation'], group = g_LABELS)
ext_which           = input.string("All", "...From Which Sessions", options = ['Most Recent', 'All'], group = g_LABELS)

kzp_style           = get_line_type(input.string(defval = 'Solid', title = "Pivot Style", options = ['Solid', 'Dotted', 'Dashed'], inline = "KZP", group = g_LABELS))
