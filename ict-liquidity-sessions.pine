// New inputs are appended at the end so existing settings keep their positions
var g_PDL           = "Previous Day / Week / Month / Year High & Low"
show_pdl            = input.bool(true, "Show PDH / PDL", inline = "PDL", group = g_PDL)
pdl_color           = input.color(#000000, "", inline = "PDL", group = g_PDL)
pdl_max             = input.int(10, "Days", 1, 50, inline = "PDL", group = g_PDL, tooltip = "How many previous days to keep. 1 = yesterday only (PD High / PD Low). More also keeps older days that are still unbroken (P2D, P3D, ...)")
pdl_style           = get_line_type(input.string('Solid', "Style", options = ['Solid', 'Dotted', 'Dashed'], inline = "PDL2", group = g_PDL))
pdl_width           = input.int(1, "", 1, 4, inline = "PDL2", group = g_PDL)
pdl_bg              = input.bool(true, "Label Background", inline = "PDL2", group = g_PDL)
pdl_hide_mit        = input.bool(true, "Hide Broken Levels After", inline = "PDL3", group = g_PDL)
pdl_hide_days       = input.int(3, "", 1, 50, inline = "PDL3", group = g_PDL, tooltip = "Broken levels are removed this many days after they were broken. Weekly levels stay 5x as long, monthly levels 20x, yearly levels 240x.")
pdl_alerts          = input.bool(true, "Alert Broken Levels", group = g_PDL)
