pwl_tf_limit        = input.timeframe("D", "PWH / PWL Timeframe Limit", group = g_PDL, tooltip = "PWH / PWL will not appear on timeframes above this")

show_pml            = input.bool(true, "Show PMH / PML", inline = "PML", group = g_PDL)
