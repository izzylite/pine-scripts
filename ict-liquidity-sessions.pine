show_ss_text        = input.bool(false, "Display Text", inline = "SS", group = g_SS)
box_transparency_ss    = input.int(90, "Box Transparency", 0, 100, group = g_SS)
text_transparency_ss   = input.int(50, "Text Transparency", 0, 100, group = g_SS)

use_asia_ss            = input.bool(true, "", inline = "ASIA_SESSION", group = g_SS)
