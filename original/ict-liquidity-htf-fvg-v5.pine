// ---------------------------------------- HTF Imbalance Logic --------------------------------------------------
//+------------------------------------------------------------------------------------------------------------+//
//+--- Types                                                                                                ---+//
//+------------------------------------------------------------------------------------------------------------+//
type Settings 
    bool    CE_show
    string  CE_style
    color   CE_color
    string  CE_limit
    bool    Border_show
    string  mitigated_type
    color   mitigated_color_bull
    color   mitigated_color_bear
    bool    ltf_hide
    bool    ctf_show
    bool    label_show
    string    fvg_style
    int    fvg_width
    bool    show_fvg_border
    string    ifvg_style
    int    ifvg_width
    bool    show_ifvg_border
    // bool    label_show_bg
    color   label_color
    color   label_bgcolor
    string  label_size
    string  label_limit
    int     padding
    int     buffer

type Imbalance_Settings
    bool    show
    string  htf
    color   col
    color   mit_col
    bool    alert
    bool    mitigated_show
    int     max_count
    bool    show_inverse_imb

type Imbalance
    int     open_time
    int     close_time
    float   open
    float   middle
    float   close
    bool  ifvg
    bool invalid_ifvg
    mitigated mit 
    line    line_middle
    bool    alerted
    bool    alerted_ce
    label   lbl
    box     box

type ImbalanceStructure
    Imbalance[]         imbalance
    Imbalance_Settings  settings

type Helper
    string name         = "Helper"
    string bullish_arrow = "▲"
    string bearish_arrow = "▼"

 
