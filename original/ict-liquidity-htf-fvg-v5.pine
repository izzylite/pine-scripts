//Used internally for padding
var int TF_1        = 0
var int TF_2        = 0
var int TF_3        = 0
var int TF_4        = 0
var int TF_5        = 0
var int TF_6        = 0
var int TF_7        = 0

var float daily     = 0
var float monthly   = 0
//+------------------------------------------------------------------------------------------------------------+//
//+--- Methods                                                                                              ---+//
//+------------------------------------------------------------------------------------------------------------+//
method LineStyle(Helper helper, string style) =>
    helper.name := style

    out = switch style
        '----' => line.style_dashed
        '····' => line.style_dotted
        => line.style_solid
    
    out

method Gethtftext(Helper helper, string htf) =>
    helper.name := htf

    formatted = htf
    seconds = timeframe.in_seconds(htf)

    if seconds < 60
        formatted := str.tostring(seconds) + "s"
    else if (seconds / 60) < 60
        formatted := str.tostring((seconds/60)) + "m"
    else if (seconds/60/60) < 24
        formatted := str.tostring((seconds/60/60)) + "H"
    
    formatted

method Validtimeframe(Helper helper, tf, equal) =>
    helper.name := tf
    n1 = timeframe.in_seconds()
    n2 = timeframe.in_seconds(tf)
    if(equal and n1 == n2)
        true
    else
        n1 < n2

method ProximityRange(Helper helper, tf) =>
    helper.name := tf
    float range_high    = 0
    float range_low   = 0
    if timeframe.isseconds or timeframe.isminutes
        range_high := close + daily
        range_low  := close - daily
    if timeframe.isdaily
        range_high := close + monthly*3
        range_low  := close - monthly*3
    if timeframe.isweekly
        range_high := close + monthly*12
        range_low  := close - monthly*12

    [range_low, range_high]

//+------------------------------------------------------------------------------------------------------------+//
//+--- Imbalances Methods                                                                                   ---+//
//+------------------------------------------------------------------------------------------------------------+//


method UpdateImbalance(ImbalanceStructure IS,Imbalance imb,int buffer, bool is_mit, bool ifvg,string txt_label)=>
    
    int mitigated_time = get_mitigation_time(imb.mit)
    box.set_right(imb.box, is_mit ? mitigated_time : buffer)
    box.set_bgcolor(imb.box, is_mit ? IS.settings.mit_col : IS.settings.col)
    box.set_border_style(imb.box, ifvg and not is_mit? settings.ifvg_style : settings.fvg_style)

    box.set_border_width(imb.box, ifvg? settings.show_ifvg_border ? settings.ifvg_width : 0 : settings.show_fvg_border? settings.fvg_width : 0)
    box.set_border_color(imb.box, settings.show_fvg_border and not ifvg ? is_mit? IS.settings.col : color.new(IS.settings.col, color.t(IS.settings.col)/ 3) : IS.settings.col)
    
    if settings.label_show and timeframe.in_seconds(IS.settings.htf) >= timeframe.in_seconds(settings.label_limit)
        label.set_x(imb.lbl, is_mit ? mitigated_time : buffer)
        label.set_text(imb.lbl,IS.settings.show_inverse_imb and ifvg and not imb.invalid_ifvg? (imb.open < imb.close?helper.bearish_arrow:helper.bullish_arrow)+helper.Gethtftext(IS.settings.htf)+" IFVG" : txt_label)
        label.set_textcolor(imb.lbl, color.new(IS.settings.col, color.t(IS.settings.col)/ 3))
        // label.set_color(imb.lbl,settings.label_show_bg? is_mit? color_transparent :color.new(IS.settings.col, color.t(IS.settings.col)/ 3) : color_transparent)
        //label.delete(imb.lbl)

    if settings.CE_show and timeframe.in_seconds(IS.settings.htf) >= timeframe.in_seconds(settings.CE_limit)
        line.set_x2(imb.line_middle, is_mit ? mitigated_time : buffer)
        line.set_color(imb.line_middle,settings.CE_color)
    bool clear = false
    bool clear_mit = time > mitigated_time + timeframe.in_seconds(IS.settings.htf) * 1000 // To milliseconds
    if is_mit
        if IS.settings.show_inverse_imb and not IS.settings.mitigated_show
            if not ifvg
                clear := clear_mit
            else if imb.invalid_ifvg
                clear := true
        else if not IS.settings.mitigated_show
            clear := clear_mit

        if clear
            if not na(imb.box)
                box.delete(imb.box)
                line.delete(imb.line_middle)
                label.delete(imb.lbl)
 
    is_mit



// AddZone is used to display and manage imbalance related boxes
method AddZone(ImbalanceStructure IS, Imbalance imb, int step) =>
    bool visible = true
    if IS.settings.show
        
    
        int buffer = time+((time-time[1])*(settings.padding+1+(settings.buffer*(step-1))))
        string txt_label = (imb.open < imb.close?helper.bullish_arrow:helper.bearish_arrow)+helper.Gethtftext(IS.settings.htf)
        bool is_mitigated = is_mitigated(imb.mit)
        int mitigated_time = get_mitigation_time(imb.mit)
        bool ifvg_invalid = IS.settings.show_inverse_imb and imb.ifvg and imb.invalid_ifvg
        bool is_mit_or_ifvg_is_invalid = ifvg_invalid or (is_mitigated and not IS.settings.show_inverse_imb)
        color imb_border_col = color.new(IS.settings.col, color.t(IS.settings.col)/ 3)
        if na(imb.box)
            imb.box := box.new(imb.open_time, imb.open, buffer, imb.close, settings.Border_show ? imb_border_col : color_transparent, settings.Border_show ? 2 : 0, bgcolor = IS.settings.col, xloc=xloc.bar_time)
            if settings.label_show and timeframe.in_seconds(IS.settings.htf) >= timeframe.in_seconds(settings.label_limit)
                imb.lbl := label.new(buffer, imb.middle, text=txt_label, xloc=xloc.bar_time, textcolor= imb_border_col, style=label.style_label_left,  color=color_transparent, size = settings.label_size)
                // imb.lbl := label.new(buffer, imb.middle, text=txt_label, xloc=xloc.bar_time, textcolor=settings.label_color, style=label.style_label_left,  color= settings.label_show_bg? color.new(IS.settings.col, color.t(IS.settings.col)/ 3) : color_transparent, size = settings.label_size)
            if settings.CE_show and timeframe.in_seconds(IS.settings.htf) >= timeframe.in_seconds(settings.CE_limit)
                imb.line_middle := line.new(imb.open_time, imb.middle, buffer, imb.middle, xloc=xloc.bar_time, style=helper.LineStyle(settings.CE_style), color=settings.CE_color)
        // else --- fix mitigate fvg from showing as fresh fvg
        
        if (IS.settings.show_inverse_imb and IS.settings.mitigated_show) or (IS.settings.show_inverse_imb and not IS.settings.mitigated_show)
            if is_mitigated and not imb.ifvg
                UpdateImbalance(IS,imb,buffer,true,false,txt_label)
            else if imb.ifvg
                UpdateImbalance(IS,imb,buffer,imb.invalid_ifvg,true,txt_label)
            else 
                UpdateImbalance(IS,imb,buffer,is_mitigated,false,txt_label)

        else 
            UpdateImbalance(IS,imb,buffer,is_mitigated,false,txt_label)

       



// AddImbalance adds a newly discovered imbalance. this applies for both FVG and Volume Imbalance
method AddImbalance(ImbalanceStructure IS, float o, float c, int o_time) =>
    Imbalance imb = Imbalance.new()
    imb.open_time           := o_time
    imb.open                := o
    imb.middle              := (o+c)/2
    imb.close               := c

    IS.imbalance.unshift(imb)
    //IS.AddZone(imb)

    if IS.imbalance.size() > 100 //IS.settings.max_count
        temp = IS.imbalance.pop()
        if not na(temp.box)
            box.delete(temp.box)
            line.delete(temp.line_middle)
            label.delete(temp.lbl)
    IS


getRecentPHL_Mit(dwm_hl hl,Imbalance imb, bool h)=>
    mitigated[] hit_line = h ? hl.hit_h_line : hl.hit_l_line
    mitigated m = na
    int size = array.size(hit_line)

    if size > 0
        int imb_year = year(imb.open_time, gmt_tz)
        int imb_month = month(imb.open_time, gmt_tz)
        int imb_day = dayofmonth(imb.open_time, gmt_tz)
        
        for i = size - 1 to 0
            mitigated mit = array.get(hit_line, i)
            if is_mitigated(mit) // Check if both timestamps fall on the same day
                int mit_year = year(mit.timestamp, gmt_tz)
                int mit_month = month(mit.timestamp, gmt_tz)
                int mit_day = dayofmonth(mit.timestamp, gmt_tz)
                
                if mit_year == imb_year and mit_month == imb_month and mit_day == imb_day
                    m := mit
                    break
    m

createImbAlertText(Imbalance imb,string imbtf,bool bullish, bool ce) =>
    y_alert_info = getRecentPHL_Mit(y_hl,imb,bullish ? false : true)
    m_alert_info = na(y_alert_info) ? getRecentPHL_Mit(m_hl,imb,bullish ? false : true) : na
    w_alert_info = na(m_alert_info) ? getRecentPHL_Mit(w_hl,imb,bullish ? false : true) : na
    d_alert_info = na(w_alert_info) ? getRecentPHL_Mit(d_hl,imb,bullish ? false : true) : na
    mitigated x = na
    if not na(y_alert_info)
        x := y_alert_info
    else if not na(m_alert_info)
        x := m_alert_info
    else if not na(w_alert_info)
        x := w_alert_info
    else if not na(d_alert_info)
        x := d_alert_info
     
    if na(x)
        "Price hit "+imbtf+ (bullish?" bullish":" bearish")+" FVG"+(ce?" C.E":"")
    else 
        "Price hit "+imbtf+ (bullish?" bullish":" bearish")+" FVG"+(ce?" C.E":"")+" after sweeping P"+x.tf+ (bullish?" Low":" High")
        
  


method AlertImbalance(ImbalanceStructure IS, Imbalance imb) =>
    if IS.settings.alert
        string imbtf = helper.Gethtftext(IS.settings.htf)
        if imb.open <= imb.close //alert bullish imbalance
            if low <= imb.close and imb.open < low and not imb.alerted
                alert(createImbAlertText(imb,imbtf,true,false), alert.freq_once_per_bar)
                imb.alerted := true
            else if low <= imb.middle and imb.open < low and not imb.alerted_ce
                alert(createImbAlertText(imb,imbtf,true,true), alert.freq_once_per_bar)
                imb.alerted_ce := true
        else //alert bearish imbalance
            if high >= imb.close and imb.open > high and not imb.alerted
                alert(createImbAlertText(imb,imbtf,false,false), alert.freq_once_per_bar)
                imb.alerted := true
            else if high >= imb.middle and imb.open > high and not imb.alerted_ce
                alert(createImbAlertText(imb,imbtf,false,true), alert.freq_once_per_bar)
                imb.alerted_ce := true

// CheckMitigated checks if the imbalance has been mitigated based on the settings
method CheckMitigated(ImbalanceStructure IS, o, h, l, c) =>
    if IS.imbalance.size() > 0
        int[] invalids = na
     
        int imbalances_size = array.size(IS.imbalance)
        if imbalances_size > 0
            for i = imbalances_size - 1 to 0
                Imbalance imb = array.get(IS.imbalance, i)
                bool is_mit = is_mitigated(imb.mit)

            
                if not is_mit
                    float minus_percentage = 0.01 / 100 * imb.open
                    float open_minus_percentage = imb.open - minus_percentage
                    float open_plus_percentage = imb.open + minus_percentage
                    float min_oc = math.min(o, c)
                    float max_oc = math.max(o, c)
                    
                    switch settings.mitigated_type
                        "None" =>
                            is_mit := false
                        "Wick filled" =>
                            is_mit := imb.open <= imb.close ? l <= open_plus_percentage : h >= open_minus_percentage
                        "Body filled" =>
                            is_mit := imb.open < imb.close ? min_oc <= open_plus_percentage : max_oc >= open_minus_percentage
                        "Wick filled half" =>
                            is_mit := imb.open <= imb.close ? l <= imb.middle : h >= imb.middle
                        "Body filled half" =>
                            is_mit := imb.open <= imb.close ? min_oc <= imb.middle : max_oc >= imb.middle
                    
                    if is_mit and na(imb.mit)
                        imb.mit := mitigated.new(is_mit, time)

                    if is_mit
                        if not IS.settings.mitigated_show and not IS.settings.show_inverse_imb
                            if na(invalids)
                                invalids := array.new_int()
                            else
                                array.unshift(invalids, i)
                    else
                        AlertImbalance(IS, imb)
                    
            
            if not na(invalids)
                if array.size(invalids) > 0
                    for i = array.size(invalids) - 1 to 0
                        int invalid_idx = array.get(invalids, i)
                        Imbalance imb = array.get(IS.imbalance, invalid_idx)
                        if not na(imb.box)
                            box.delete(imb.box)
                            line.delete(imb.line_middle)
                            label.delete(imb.lbl)
                        array.remove(IS.imbalance, invalid_idx)
               
    IS


 
method CheckIFVG(ImbalanceStructure IS) =>
    if timeframe.change(IS.settings.htf)
        int size = IS.imbalance.size()
        if size > 0 
            for i = size - 1 to 0
                imb = IS.imbalance.get(i)  
                
                if IS.settings.show_inverse_imb
                    if not imb.ifvg and not imb.invalid_ifvg
                        bullish_mid_range = imb.middle - imb.open
                        bearish_mid_range = imb.open - imb.middle
                        minus_percentage = 50
                        half_bull_mid_range = bullish_mid_range - ((float(minus_percentage)/100)*bullish_mid_range)
                        half_bear_mid_range = bearish_mid_range - ((float(minus_percentage)/100)*bearish_mid_range)
                        // if greater than half of fvg mid range
                        imb.ifvg := imb.open < imb.close ? close[1] < imb.open - half_bull_mid_range : close[1] > imb.open + half_bear_mid_range
                    else if imb.ifvg and not imb.invalid_ifvg
                        imb.invalid_ifvg := imb.open < imb.close ? high[1] > imb.close : low[1] < imb.close
        
   


method AdjustMargins(ImbalanceStructure IS, int step) =>
    int count = 0
    if IS.imbalance.size() > 0
        int buffer = time+((time-time[1])*(settings.padding+1+(settings.buffer*(step-1))))
        
        [rl, rh] = helper.ProximityRange(IS.settings.htf)

        for i = 0 to IS.imbalance.size() - 1
            imb = IS.imbalance.get(i)

            if ((math.max(imb.open, imb.close) > rl) and (math.min(imb.open, imb.close) < rh)) and count < IS.settings.max_count
                if IS.AddZone(imb, step)
                    count := count+1
            else
                if not na(imb.box)
                    box.delete(imb.box)
                    label.delete(imb.lbl)
                    line.delete((imb.line_middle))
    IS
// FindImbalance looks for imbalances and, if found, adds it to the list
method FindImbalance(ImbalanceStructure IS, o, h, l, c, t, o1, h1, l1, c1, t1, o2, h2, l2, c2, t2) =>
    if IS.settings.show and (h < l2 or l > h2)
        float o_ = h < l2 ? l2 : h2
        float c_ = h < l2 ? h : l 
        if IS.imbalance.size() == 0 
            IS.AddImbalance(o_, c_, t2)
        else
            if IS.imbalance.first().open_time < t2
                IS.AddImbalance(o_, c_, t2)
    IS

method Process(ImbalanceStructure IS, float o, float h, float l, float c, int t, float o1, float h1, float l1, float c1, int t1, float o2, float h2, float l2, float c2, int t2) =>
    var int visible = 0
    if IS.settings.show
        if not settings.ltf_hide or (settings.ltf_hide and helper.Validtimeframe(IS.settings.htf,settings.ctf_show))
            if IS.settings.show
                IS.FindImbalance(o, h, l, c, t, o1, h1, l1, c1, t1, o2, h2, l2, c2, t2)
                visible := 1
        
        IS.CheckMitigated(o, h, l, c)
        IS.CheckIFVG()
        
    visible
//+------------------------------------------------------------------------------------------------------------+//
//+--- Main call to start the process                                                                       ---+//
//+------------------------------------------------------------------------------------------------------------+//

daily                                   := request.security(syminfo.tickerid, "1D", ta.atr(14))
monthly                                 := request.security(syminfo.tickerid, "1M", ta.atr(14))

