[o_7, h_7, l_7, c_7, t_7]               = request.security(syminfo.tickerid, htf_7, [open[1], high[1], low[1], close[1], time[1]])
[o1_7, h1_7, l1_7, c1_7, t1_7]          = request.security(syminfo.tickerid, htf_7, [open[2], high[2], low[2], close[2], time[2]])
[o2_7, h2_7, l2_7, c2_7, t2_7]          = request.security(syminfo.tickerid, htf_7, [open[3], high[3], low[3], close[3], time[3]])
