// ---------------------------------------- Variables & Constants --------------------------------------------------
type quater_cycles
    string q1
    string q2
    string q3
    string q4_s
    string q4_e
    line[] _line


type kz
    string _title

    box[] _box

    line[] _hi_line
    line[] _md_line
    line[] _lo_line

    label[] _hi_label
    label[] _lo_label

    bool[] _hi_valid
    bool[] _md_valid
    bool[] _lo_valid
 

type hz
    line[] LN
    label[] LB
    bool[] CO
type mitigated
    bool is_mit
    int timestamp
    int barIndex
    string tf

type dwm_hl
    string tf
    line[] hi_line
    line[] lo_line
    label[] hi_label
    label[] lo_label
    int originalSize
    mitigated[] hit_h_line
    mitigated[] hit_l_line

type lines
    line line = na
    bool hit_line = false

type dwm_info
    string tf
    int alert_timestamp = 0
    float o = na
    float h = na
    float l = na
    float ph = na
    float pl = na

