t_v1 = not na(time("", v1, gmt_tz))
t_v2 = not na(time("", v2, gmt_tz))
t_v3 = not na(time("", v3, gmt_tz))

var d_sep_line = array.new_line()
var w_sep_line = array.new_line()
var m_sep_line = array.new_line()
var y_sep_line = array.new_line()
var m3_sep_line = array.new_line()

var d_line = array.new_line()
var w_line = array.new_line()
var m_line = array.new_line()
var y_line = array.new_line()
var m3_line = array.new_line()

var d_label = array.new_label()
var w_label = array.new_label()
var m_label = array.new_label()
var y_label = array.new_label()
var m3_label = array.new_label()

var v1_line = array.new_line()
var v2_line = array.new_line()
var v3_line = array.new_line()

var transparent = #ffffff00
var ext_current = ext_which == 'Most Recent'
var ext_past = ext_pivots == 'Past Mitigation'

update_dwm_info(dwm_info n) =>
    if timeframe.change(n.tf)
        n.ph := n.h
        n.pl := n.l
        n.o := open
        n.h := high
        n.l := low
    else
        n.h := math.max(high, n.h)
        n.l := math.min(low,  n.l)



if dhl or show_d_open
    update_dwm_info(d_info)
if whl or show_w_open
    update_dwm_info(w_info)
if mhl or show_m_open
    update_dwm_info(m_info)
if yhl or show_y_open
    update_dwm_info(y_info)
if show_pdshl
    update_dwm_info(px_info)   

// ---------------------------------------- Variables & Constants --------------------------------------------------


// ---------------------------------------- Functions --------------------------------------------------
get_color(color c,  int trans) =>
    result = color.new(c, trans)

is_mitigated(mitigated mit) => 
    if not na(mit)
        mit.is_mit
    else
        false

get_mitigation_time(mitigated mit) => 
    if is_mitigated(mit)
        mit.timestamp
    else 
        0
 
// ---------------------------------------- Functions --------------------------------------------------


// ---------------------------------------- Core Logic --------------------------------------------------
dwm_sep(string tf, bool use, line[] arr, color col) =>
    if use 
        if timeframe.change(tf)
            arr.unshift(line.new(bar_index, high*1.0001, bar_index, low, style = sep_style, width = sep_width, extend = extend.both, color = col))
            if arr.size() > max_sep
                arr.pop().delete()
                

dwm_open(string tf, bool use, line[] lns, label[] lbls, dwm_info n, color col) =>
    if use
        if timeframe.change(tf)
            lns.unshift(line.new(time, n.o, time, n.o, xloc = xloc.bar_time, style = op_style, width = op_width, color = col))
            lbls.unshift(label.new(time, n.o, tf + " OPEN", xloc = xloc.bar_time, style = label.style_label_left, color = transparent, textcolor = col, size = lbl_size))
            if  (not show_prev_op and lns.size() > max_op) or (show_d_open and lns.size() > max_days)
                lns.pop().delete()
                lbls.pop().delete()
        else if lns.size() > 0
            lns.get(0).set_x2(time)
            lbls.get(0).set_x(time)
// Calculate the difference in seconds between the timestamps
// time_difference_seconds = abs(timestamp1 - timestamp2)
// Convert the difference to hours
// time_difference_hours = time_difference_seconds / 3600 // 3600 seconds in an hour
// Check if the difference is greater than 1 hour
        if use_op_alerts and lns.size() > 0 
            if n.alert_timestamp == 0 or (math.abs(time - n.alert_timestamp) / 3600) >= 1
                line_value = lns.get(0).get_y1()
                price_crosses_line_up = high[1] < line_value and high >= line_value
                price_crosses_line_down = low[1] > line_value and low <= line_value
                if price_crosses_line_up or price_crosses_line_down
                    alert("Price hit "+tf+" Opening Price")
                    n.alert_timestamp := time

getDayHL(int days, bool h,string tf = "D") => 
    request.security(syminfo.tickerid, tf, h? high[days] : low[days])
 
     
method check_lines_hit(bool hl, line ph_line,label ph_label,mitigated hit_line, string tf,color col, dwm_info custom_info) =>
    bool hit = hit_line.is_mit
    string txt = hl?" High":" Low"
    string _tf = str.replace(tf,"12M","Y")
    bool first_hit = hl? ((na(custom_info) ? high >= ph_line.get_y1() : custom_info.ph > ph_line.get_y1()) and not hit) : ((na(custom_info) ? low <= ph_line.get_y1() : custom_info.pl < ph_line.get_y1()) and not hit)
    ph_label.set_text(not hit? "P"+_tf+txt+" ✔" : "P"+_tf+txt+" ✖")
    if not hit and na(custom_info)
        ph_line.set_x2(time)
        ph_label.set_x(time)
    
    ph_label.set_size(hit and hl_bg == false?size.tiny:lbl_size)
    if first_hit
        hit_line.is_mit := true
        hit_line.timestamp := time
        hit_line.tf := tf
        color cl = color.new(col,40)
        ph_line.set_color(cl)
        ph_label.set_color(hl_bg? cl : transparent)  
        ph_label.set_textcolor(hl_bg? color.white : cl) 
        ph_label.set_text("P"+_tf+txt+" ✖")
        if use_hl_alerts
            alert("Previous "+_tf+txt+" Broken 🔥🔥", alert.freq_once_per_bar)
        
   
 
max_mit_count(string tf) => 
    if(tf=="D")
        pdshl_mit_count
    else if(tf=="W")
        pdshl_mit_count * 5
    else if(tf=="M")
        pdshl_mit_count * 20
    else if(tf=="12M")
        pdshl_mit_count * 240
    else 
        pdshl_mit_count
 
manage_hit_lines(bool hl, array<line> lines,array<label> labels,array<mitigated> hit_lines, string tf, color col, int originalSize) => 
    
    if array.size(lines) > 0
        int i = 0
        
        while i <= (array.size(lines)-1)
            line _line = array.get(lines, i)
            label _label = array.get(labels, i)
            mitigated _hit_line = array.get(hit_lines, i)
            int index = originalSize - _hit_line.barIndex
            string txt = i == 0 ? tf : str.tostring(index) + tf
            
            check_lines_hit(hl, _line, _label, _hit_line, txt, col, na)
            
            if hide_pdshl_mit  // start_date + days_to_check * 86400000 milliseconds in a day
                if _hit_line.is_mit and time >= _hit_line.timestamp + max_mit_count(tf) * 86400000
                    _line.delete()
                    _label.delete()
                    array.remove(lines, i)
                    array.remove(labels, i)
                    array.remove(hit_lines, i)
                    i := i - 1 // Update size after removal
            i := i + 1

         
remove_duplicate_lines(dwm_hl current_hl,dwm_hl prev_hl) =>
    if current_hl.tf != prev_hl.tf
        if(current_hl.hi_line.size()>0)
            line[] prev_lines = prev_hl.hi_line
            for [index, _line_h] in current_hl.hi_line
                for [prev_index, prev_line] in prev_lines
                   
                    if prev_line.get_y1() == _line_h.get_y1() and not str.startswith(current_hl.hi_label.get(index).get_text(),"PD")
                        current_hl.hi_line.get(index).delete()
                        current_hl.hi_label.get(index).delete()
                        current_hl.hi_line.remove(index)
                        current_hl.hi_label.remove(index)
                        current_hl.hit_h_line.remove(index)
                        break
        
        if(current_hl.lo_line.size()>0)
            line[] prev_lines = prev_hl.lo_line
            for [index, _line_l] in current_hl.lo_line
                for [prev_index, prev_line] in prev_lines
                    if prev_line.get_y1() == _line_l.get_y1() and not str.startswith(current_hl.lo_label.get(index).get_text(),"PD")
                        current_hl.lo_line.get(index).delete()
                        current_hl.lo_label.get(index).delete()
                        current_hl.lo_line.remove(index)
                        current_hl.lo_label.remove(index)
                        current_hl.hit_l_line.remove(index)
                        break
            
    
    
  
dwm_hl(string tf, bool use, dwm_hl hl,dwm_hl prev_hl, dwm_info n, color col, int max_draw,string hl_tf_limit) =>
     
    if use and timeframe.in_seconds("") <= timeframe.in_seconds(hl_tf_limit)
        if timeframe.change(tf)
            hl.hi_line.unshift(line.new(time, n.ph, time, n.ph, xloc = xloc.bar_time, style = hl_style, width = hl_width, color = col))
            hl.hi_label.unshift(label.new(time, n.ph, "P"+tf+" High ✔", xloc = xloc.bar_time, style = label.style_label_left, color = hl_bg? col : transparent, textcolor = hl_bg? color.white : col, size = lbl_size))
            hl.hit_h_line.unshift(mitigated.new(false,0,hl.originalSize,tf))
        

            hl.lo_line.unshift(line.new(time, n.pl, time, n.pl, xloc = xloc.bar_time, style = hl_style, width = hl_width, color = col))
            hl.lo_label.unshift(label.new(time, n.pl, "P"+tf+" Low ✔", xloc = xloc.bar_time, style = label.style_label_left, color = hl_bg? col : transparent, textcolor = hl_bg? color.white : col, size = lbl_size))
            hl.hit_l_line.unshift(mitigated.new(false,0,hl.originalSize,tf))

        
            hl.originalSize := hl.originalSize + 1
            if hl.hi_line.size() > max_draw
                hl.hit_h_line.pop()
                hl.hit_l_line.pop()
                hl.hi_line.pop().delete()
                hl.lo_line.pop().delete()
                hl.hi_label.pop().delete()
                hl.lo_label.pop().delete()
                
               
        else if hl.hi_line.size() > 0 or hl.lo_line.size() > 0
            if hl.hi_line.size() > 0
                hl.hi_line.get(0).set_x2(time)
                hl.hi_label.get(0).set_x(time)

            if hl.lo_line.size() > 0
                hl.lo_line.get(0).set_x2(time)
                hl.lo_label.get(0).set_x(time)
    
        remove_duplicate_lines(hl,prev_hl)
        manage_hit_lines(true,hl.hi_line,hl.hi_label,hl.hit_h_line,tf,col,hl.originalSize)
        manage_hit_lines(false,hl.lo_line,hl.lo_label,hl.hit_l_line,tf,col,hl.originalSize)
        

    


 

pxhl() =>
    
    if show_pdshl and timeframe.in_seconds("") <= timeframe.in_seconds(dhl_tf_limit)
         // Get high and low values from x days ago
        high_xdays_ago = getDayHL(pdshl_count,true)
        low_xdays_ago = getDayHL(pdshl_count,false)
        px_hl.hi_line.unshift(line.new(bar_index[pdshl_count], high_xdays_ago, bar_index, high_xdays_ago,style = hl_style, color=pdshl_color, width=hl_width, extend = extend.left))
        px_hl.lo_line.unshift(line.new(bar_index[pdshl_count], low_xdays_ago, bar_index, low_xdays_ago,style = hl_style, color=pdshl_color, width=hl_width, extend = extend.left))
        px_hl.hi_label.unshift(label.new(x=bar_index[pdshl_count], y=high_xdays_ago, text= "P"+px_info.tf+" High ✔", style = label.style_label_left, color = pdshl_color, textcolor = color.white, size = lbl_size))
        px_hl.lo_label.unshift(label.new(x=bar_index[pdshl_count], y=low_xdays_ago, text= "P"+px_info.tf+" Low ✔", style = label.style_label_left, color = pdshl_color, textcolor = color.white, size = lbl_size))
        px_hl.hit_h_line.unshift(mitigated.new(false,0,0,px_info.tf))
        px_hl.hit_l_line.unshift(mitigated.new(false,0,0,px_info.tf))
            
        if px_hl.hi_line.size() > 1
            px_hl.hi_line.pop().delete()
            px_hl.lo_line.pop().delete()
            px_hl.hi_label.pop().delete()
            px_hl.lo_label.pop().delete()
            px_hl.hit_h_line.pop()
            px_hl.hit_l_line.pop()
            
    if px_hl.hi_line.size() > 0
        check_lines_hit(true,px_hl.hi_line.get(0),px_hl.hi_label.get(0),px_hl.hit_h_line.get(0),px_info.tf,pdshl_color,px_info)
        check_lines_hit(false,px_hl.lo_line.get(0),px_hl.lo_label.get(0),px_hl.hit_l_line.get(0),px_info.tf,pdshl_color,px_info)
  

    




dwm_hls(bool use = true) =>
    if use
        dwm_hl("12M", yhl, y_hl,y_hl, y_info, y_color,max_y_hl,yhl_tf_limit)
        dwm_hl("M", mhl, m_hl,y_hl, m_info, m_color,max_m_hl,mhl_tf_limit)
        dwm_hl("W", whl, w_hl,m_hl, w_info, w_color,max_w_hl,whl_tf_limit)
        dwm_hl("D", dhl, d_hl,w_hl, d_info, d_color,max_d_hl,dhl_tf_limit)
        
        
        
        
        
        
        
        
        
        

       

dwm() => 
    if timeframe.in_seconds("") <= timeframe.in_seconds(tf_limit)
        // DWM - Separators
        dwm_sep("D", ds, d_sep_line, d_color)
        dwm_sep("W", ws, w_sep_line, w_color)
        dwm_sep("M", ms, m_sep_line, m_color)
        dwm_sep("12M", ys, y_sep_line, y_color)
        
        
        // DWM - Open Lines
        dwm_open("12M", show_y_open, y_line, y_label, y_info, y_color)
        dwm_open("M", show_m_open, m_line, m_label, m_info, m_color)
        dwm_open("W", show_w_open, w_line, w_label, w_info, w_color)
        dwm_open("D", show_d_open, d_line, d_label, d_info, d_color)
        
        
        


        // DWM - Highs and Lows
    dwm_hls()
    pxhl()

    
vline(bool use, bool t, line[] arr, color col, bool alert,bool start) =>
    if use
        if start and t and not t[1] or not start and not t and t[1]
            arr.unshift(line.new(bar_index, high*1.0001, bar_index, low, style = vl_style, width = vl_width, extend = extend.both, color = col))
            if alert
                alert(start? "SB session started" : "SB session ended", alert.freq_once_per_bar)
            if arr.size()/2 > vl_limit
                arr.pop().delete()
        if(vl_clear and arr.size()>0 and not start and not t and not t[1])
            for i = arr.size()-1 to 0
                array.remove(arr,i).delete()
            
vlines() =>
    
    if timeframe.in_seconds("") <= timeframe.in_seconds(tf_limit)
        vline(use_v1, t_v1, v1_line, v1_color,v1_alert,true)
        vline(use_v1, t_v1, v1_line, v1_color,v1_alert,false)

        vline(use_v2, t_v2, v2_line, v2_color,v2_alert,true)
        vline(use_v2, t_v2, v2_line, v2_color,v2_alert,false)

        vline(use_v3, t_v3, v3_line, v3_color,v3_alert,true)
        vline(use_v3, t_v3, v3_line, v3_color,v3_alert,false)
         
 

get_target_time(_time) =>
    int _hour = math.round(str.tonumber(str.substring(_time,0,2)))
    int _minute = math.round(str.tonumber(str.substring(_time,2,4)))
    timestamp(gmt_tz,year, month, dayofmonth, _hour,_minute)

// Function to plot a vertical line at a specific time
plot_line_at_time(int target_time,string label_text, quater_cycles qc, color _color) => 
    // Check if the target time is either in the future or already reached
    // using (time[1] - time[2] to calculate the timeframe
    bar_offset = (target_time - time) / (time[1] - time[2])
    qc._line.unshift(line.new(bar_index + bar_offset, close, bar_index + bar_offset, close, xloc=xloc.bar_index, color=_color, width=qt_width, style=qt_style, extend=extend.both))
    // qc._label.unshift(label.new(bar_index + bar_offset, low-10, label_text, xloc=xloc.bar_index, color=color.blue, textalign=text.align_center, style=label.style_label_down, size=size.small, textcolor=color.blue))
    

qc_vline(bool use, quater_cycles cycle,bool in_range,color _color,bool alert_q1,bool alert_q2,bool alert_q3,bool alert_q4) =>
    if use and timeframe.in_seconds("") <= timeframe.in_seconds("30")
        max_line_per_cycle = 5
        q1 = get_target_time(cycle.q1)
        q2 = get_target_time(cycle.q2)
        q3 = get_target_time(cycle.q3)
        q4 = get_target_time(cycle.q4_s)
        if in_range and not in_range[1]
            plot_line_at_time(q1,"q1",cycle,_color)
            plot_line_at_time(q2,"q2",cycle,_color)
            plot_line_at_time(q3,"q3",cycle,_color)
            plot_line_at_time(q4,"q4",cycle,_color)
            plot_line_at_time(get_target_time(cycle.q4_e),"",cycle,_color)
        else if qt_clear and not in_range and in_range[1]
            for i = 1 to max_line_per_cycle by 1
                cycle._line.pop().delete()
        else 
            if(time == q1 and alert_q1)
                alert("Q1 started", alert.freq_once_per_bar)
            else if(time == q2 and alert_q2)
                alert("Q2 started", alert.freq_once_per_bar)
            else if(time == q3 and alert_q3)
                alert("Q3 started", alert.freq_once_per_bar)
            else if(time == q4 and alert_q4)
                alert("Q4 started", alert.freq_once_per_bar)

        if(cycle._line.size()/max_line_per_cycle > qt_max)
            for i = 1 to max_line_per_cycle by 1
                cycle._line.pop().delete()
                    // cycle._label.pop().delete()
            

qc_vline(use_lc, london_cycle,t_l_c,lc_color,alert_lc_q1,alert_lc_q2,alert_lc_q3,alert_lc_q4)
qc_vline(use_nyc, ny_cycle,t_ny_c,nyc_color,alert_ny_q1,alert_ny_q2,alert_ny_q3,alert_ny_q4)


hz_line(bool use, bool t, hz hz, string txt, color col) =>
    if use
        if t and not t[1]
            hz.LN.unshift(line.new(bar_index, open, bar_index, open, style = hz_style, width = hz_width, color = col))
            hz.LB.unshift(label.new(bar_index, open, txt, style = label.style_label_left, color = transparent, textcolor = col, size = lbl_size))
            array.unshift(hz.CO, false)
            if (not show_prev_op_2 and hz.LN.size() > 1) or (hz.LN.size() > max_days)
                hz.LN.pop().delete()
                hz.LB.pop().delete()
                hz.CO.pop()

        if not t and hz.CO.size() > 0
            if not hz.CO.get(0)
                hz.LN.get(0).set_x2(bar_index)
                hz.LB.get(0).set_x(bar_index)
                if (use_cutoff ? t_co : false)
                    hz.CO.set(0, true)


hz_lines() =>
    if timeframe.in_seconds("") <= timeframe.in_seconds(tf_limit)
        hz_line(use_h1, t_h1, hz_1, h1_text, h1_color)
        hz_line(use_h2, t_h2, hz_2, h2_text, h2_color)
        hz_line(use_h3, t_h3, hz_3, h3_text, h3_color)
        hz_line(use_h4, t_h4, hz_4, h4_text, h4_color)


del_kz(kz k) =>
    if k._box.size() > max_days
        k._box.pop().delete()
    if k._hi_line.size() > max_days
        k._hi_line.pop().delete()
        k._lo_line.pop().delete()
        k._hi_valid.pop()
        k._lo_valid.pop()
        if show_midpoints
            k._md_line.pop().delete()
            k._md_valid.pop()
    if k._hi_label.size() > max_days
        k._hi_label.pop().delete()
        k._lo_label.pop().delete()
    

adjust_in_kz(kz kz, bool t) =>
    if t
        kz._box.get(0).set_right(time)
        kz._box.get(0).set_top(math.max(kz._box.get(0).get_top(), high))
        kz._box.get(0).set_bottom(math.min(kz._box.get(0).get_bottom(), low))
 

        if show_pivots and kz._hi_line.size() > 0
            if high > kz._hi_line.get(0).get_y1()
                kz._hi_line.get(0).set_xy1(time, high)
                kz._hi_line.get(0).set_xy2(time, high)

            if low < kz._lo_line.get(0).get_y1()
                kz._lo_line.get(0).set_xy1(time, low)
                kz._lo_line.get(0).set_xy2(time, low)
                
            if show_midpoints
                kz._md_line.get(0).set_xy1(time, math.avg(kz._hi_line.get(0).get_y2(), kz._lo_line.get(0).get_y2()))
                kz._md_line.get(0).set_xy2(time, math.avg(kz._hi_line.get(0).get_y2(), kz._lo_line.get(0).get_y2()))

     
    

adjust_out_kz(kz kz, bool t) =>
    
    if kz._box.size() > 0 and show_pivots
        for i = 0 to kz._box.size() - 1
            if not ext_current or (ext_current and i == 0)
                if ext_past ? true : (kz._hi_valid.get(i) == true)
                    kz._hi_line.get(i).set_x2(time)
                if high > kz._hi_line.get(i).get_y1() and kz._hi_valid.get(i) == true
                    if use_alerts and i == 0
                        alert("Broke "+kz._title+" High", alert.freq_once_per_bar)
                    kz._hi_valid.set(i, false)
                else if (use_cutoff_kz ? t_co_kz : false)
                    kz._hi_valid.set(i, false)
                    
                if ext_past ? true : (kz._lo_valid.get(i) == true)
                    kz._lo_line.get(i).set_x2(time)
                if low < kz._lo_line.get(i).get_y1() and kz._lo_valid.get(i) == true
                    if use_alerts and i == 0
                        alert("Broke "+kz._title+" Low", alert.freq_once_per_bar)
                    kz._lo_valid.set(i, false)
                else if (use_cutoff_kz ? t_co_kz : false)
                    kz._lo_valid.set(i, false)
                    
                if show_midpoints
                    kz._md_line.get(i).set_x2(time)
            else
                break


manage_kz(kz kz, bool use, bool t, color c, string box_txt,bool showBx,bool showTx, bool session) => 
    if timeframe.in_seconds("") <= timeframe.in_seconds(tf_limit) and use
        if t and not t[1]
            _c = get_color(c,session ? box_transparency_ss : box_transparency_kz)
            _t = get_color(c,session ? text_transparency_ss : text_transparency_kz)
            kz._box.unshift(box.new(time, high, time, low, xloc = xloc.bar_time, border_color = showBx and session ? na : showBx ? _c : na, bgcolor = showBx ? _c : na, text = (showBx and showTx) ? box_txt : na, text_color = _t))

            if show_pivots
                kz._hi_line.unshift(line.new(time, high, time, high, xloc = xloc.bar_time, style = kzp_style, color =session ? transparent : c, width = kzp_width))
                kz._lo_line.unshift(line.new(time, low, time, low, xloc = xloc.bar_time, style = kzp_style, color =session ? transparent : c, width = kzp_width))
                if show_midpoints
                    kz._md_line.unshift(line.new(time, math.avg(high, low), time, math.avg(high, low), xloc = xloc.bar_time, style = kzm_style, color = c, width = kzm_width))
                    array.unshift(kz._md_valid, true)
                
                array.unshift(kz._hi_valid, true)
                array.unshift(kz._lo_valid, true) 
            
            del_kz(kz)
        adjust_in_kz(kz, t)
    adjust_out_kz(kz, t)
         


manage_kz(as_kz, use_asia_kz, t_as_kz, as_color_kz, as_txt_kz,show_kz,show_kz_text,false)
manage_kz(lo_kz, use_london_kz, t_lo_kz, lo_color_kz, lo_txt_kz,show_kz,show_kz_text,false)
